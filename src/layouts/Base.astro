---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { ui, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description?: string;
  hrefs: Record<Locale, string>;
}
const { lang, title, description, hrefs } = Astro.props;
const t = ui[lang];
const other: Locale = lang === 'en' ? 'es' : 'en';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="description" content={description ?? t.metaDescription} />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#fbfbf9" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href={hrefs.en} />
    <link rel="alternate" hreflang="es" href={hrefs.es} />
    <link rel="alternate" hreflang="x-default" href={hrefs.en} />
    <title>{title}</title>
    <script is:inline>
      try {
        var t = localStorage.getItem('sf:theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
  </head>
  <body class="flex min-h-screen flex-col bg-canvas text-ink">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-brand focus:px-4 focus:py-2 focus:text-on-brand">Skip to content</a>
    <header class="sticky top-0 z-40 border-b border-line/70 bg-canvas/80 backdrop-blur">
      <div class="mx-auto flex h-16 w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
        <a href={`/${lang}/`} class="flex items-center gap-2.5 font-semibold tracking-tight">
          <svg viewBox="0 0 32 32" class="h-7 w-7" aria-hidden="true">
            <rect x="3" y="7" width="22" height="18" rx="5" class="fill-brand-soft stroke-brand" stroke-width="2" />
            <rect x="8" y="3" width="22" height="18" rx="5" class="fill-surface stroke-brand" stroke-width="2" />
            <path d="M14 12h10M14 16h6" class="stroke-brand" stroke-width="2" stroke-linecap="round" />
          </svg>
          <span>{t.siteTitle}</span>
        </a>
        <nav class="hidden items-center gap-6 text-sm text-mute md:flex" aria-label="Primary">
          <a href={`/${lang}/#why`} class="transition hover:text-ink">{t.nav.why}</a>
          <a href={`/${lang}/#how`} class="transition hover:text-ink">{t.nav.how}</a>
          <a href={`/${lang}/#topics`} class="transition hover:text-ink">{t.nav.topics}</a>
        </nav>
        <div class="flex items-center gap-2">
          <div class="flex h-9 items-center rounded-lg border border-line bg-surface p-0.5 text-xs font-semibold" role="group" aria-label={t.languageLabel}>
            <span aria-current="true" class="rounded-md bg-brand px-2.5 py-1.5 uppercase text-on-brand">{lang}</span>
            <a href={hrefs[other]} hreflang={other} lang={other} title={t.switchTo} class="rounded-md px-2.5 py-1.5 uppercase text-mute transition hover:text-ink">{other}</a>
          </div>
          <ThemeToggle label={t.themeToggle} />
        </div>
      </div>
    </header>
    <main id="main" class="flex-1"><slot /></main>
    <footer class="border-t border-line">
      <div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-3 px-5 py-8 text-sm text-mute sm:flex-row sm:items-center sm:px-8">
        <p>{t.footer.text}</p>
        <a href="#main" class="transition hover:text-ink">{t.footer.top} ↑</a>
      </div>
    </footer>
  </body>
</html>
