---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FlashcardDeck from '../../components/FlashcardDeck';
import FlowDiagram from '../../components/FlowDiagram';
import { locales, ui, type Locale } from '../../i18n/ui';

export async function getStaticPaths() {
  const all = await getCollection('topics');
  return all
    .map((entry) => ({
      params: { lang: entry.id.split('/')[0], slug: entry.data.key },
      props: { entry },
    }))
    .filter((p) => (locales as readonly string[]).includes(p.params.lang!));
}

const { entry } = Astro.props;
const lang = Astro.params.lang as Locale;
const t = ui[lang];
const { key, title, summary, why, cards, resources, order } = entry.data;
const total = (await getCollection('topics', (e) => e.id.startsWith(`${lang}/`))).length;
const diagramEntry = entry.data.diagram ? await getEntry('diagrams', `${lang}/${entry.data.diagram}`) : undefined;
const pad = (n: number) => String(n).padStart(2, '0');
---
<Base lang={lang} title={`${title} · ${t.siteTitle}`} description={summary} hrefs={{ en: `/en/${key}/`, es: `/es/${key}/` }}>
  <div class="relative isolate overflow-hidden border-b border-line">
    <div class="hero-bg absolute inset-0 -z-10 opacity-60" aria-hidden="true"></div>
    <div class="mx-auto w-full max-w-4xl px-5 pb-12 pt-10 sm:px-8">
      <a href={`/${lang}/#topics`} class="inline-flex items-center gap-1 text-sm text-mute transition hover:text-ink">← {t.topicPage.back}</a>
      <p class="mt-8 text-sm font-bold uppercase tracking-wider text-brand">{t.topicPage.step} {pad(order)} {t.topicPage.of} {pad(total)}</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">{title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-mute">{summary}</p>
      <aside class="mt-8 rounded-2xl border border-brand/30 bg-brand-soft p-5">
        <p class="text-xs font-bold uppercase tracking-wider text-brand">{t.topicPage.why}</p>
        <p class="mt-2 leading-relaxed">{why}</p>
      </aside>
    </div>
  </div>

  <div class="mx-auto w-full max-w-4xl space-y-12 px-5 py-12 sm:px-8">
    {diagramEntry && (
      <section aria-label={t.topicPage.diagram}>
        <FlowDiagram client:load diagram={diagramEntry.data} labels={t.diagram} />
      </section>
    )}

    <section aria-label={t.topicPage.practice}>
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-mute">{t.topicPage.practice}</h2>
      <FlashcardDeck client:load topic={key} cards={cards} labels={{ ...t.deck, level: t.level }} />
    </section>

    <section>
      <h2 class="mb-4 text-sm font-bold uppercase tracking-wider text-mute">{t.topicPage.resources}</h2>
      <ul class="grid gap-3 sm:grid-cols-2">
        {resources.map((r) => (
          <li>
            <a href={r.url} rel="noopener noreferrer" target="_blank"
              class="flex items-center justify-between gap-3 rounded-xl border border-line bg-surface px-4 py-3 transition hover:border-brand">
              <span class="font-medium">{r.title}</span>
              <span class="text-brand" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Base>
