---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { locales, ui, type Locale } from '../../i18n/ui';

export function getStaticPaths() {
  return locales.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = ui[lang];
const topics = (await getCollection('topics', (e) => e.id.startsWith(`${lang}/`)))
  .sort((a, b) => a.data.order - b.data.order);
const totalCards = topics.reduce((sum, topic) => sum + topic.data.cards.length, 0);
const stats = [
  { value: topics.length, label: t.hero.stats.topics },
  { value: totalCards, label: t.hero.stats.cards },
  { value: 3, label: t.hero.stats.levels },
];
const pad = (n: number) => String(n).padStart(2, '0');
const container = 'mx-auto w-full max-w-6xl px-5 sm:px-8';
---
<Base lang={lang} title={`${t.siteTitle} · ${t.hero.title}`} hrefs={{ en: '/en/', es: '/es/' }}>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <div class="hero-bg absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class={`${container} grid items-center gap-12 pb-20 pt-16 sm:pt-24 lg:grid-cols-[1.15fr_0.85fr]`}>
      <div>
        <p class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-3 py-1 text-xs font-semibold uppercase tracking-wider text-brand">
          <span class="h-1.5 w-1.5 rounded-full bg-brand"></span>{t.hero.eyebrow}
        </p>
        <h1 class="mt-6 text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
          {t.hero.title}<br /><span class="text-gradient">{t.hero.titleAccent}</span>
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-mute">{t.hero.lead}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#topics" class="inline-flex items-center rounded-xl bg-brand px-6 py-3 font-semibold text-on-brand transition hover:opacity-90">{t.hero.primary} →</a>
          <a href="#why" class="inline-flex items-center rounded-xl border border-line bg-surface px-6 py-3 font-semibold transition hover:border-brand">{t.hero.secondary}</a>
        </div>
        <dl class="mt-12 flex gap-10">
          {stats.map((s) => (
            <div>
              <dt class="sr-only">{s.label}</dt>
              <dd class="text-3xl font-extrabold tracking-tight">{s.value}<span class="ml-1.5 text-sm font-medium text-mute">{s.label}</span></dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Decorative sample card -->
      <div class="relative mx-auto w-full max-w-sm" aria-hidden="true">
        <div class="absolute inset-0 translate-x-4 translate-y-4 rotate-3 rounded-3xl border border-line bg-surface2"></div>
        <div class="absolute inset-0 translate-x-2 translate-y-2 rotate-1 rounded-3xl border border-line bg-surface"></div>
        <div class="card-shadow relative rounded-3xl border border-line bg-surface p-7">
          <div class="flex items-center justify-between text-xs font-semibold">
            <span class="rounded-full bg-brand-soft px-2.5 py-1 text-brand">{t.hero.sample.level}</span>
            <span class="text-mute">HTTP</span>
          </div>
          <p class="mt-8 text-xl font-semibold leading-snug">{t.hero.sample.question}</p>
          <div class="mt-8 flex items-center justify-between border-t border-line pt-4 text-sm text-mute">
            <span>{t.hero.sample.hint}</span>
            <span class="font-semibold text-brand">↻</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why fundamentals -->
  <section id="why" class="scroll-mt-20 border-y border-line bg-surface2/60">
    <div class={`${container} py-20`}>
      <h2 class="max-w-2xl text-3xl font-extrabold tracking-tight sm:text-4xl">{t.why.title}</h2>
      <p class="mt-4 max-w-2xl text-lg text-mute">{t.why.lead}</p>
      <ul class="mt-12 grid gap-5 md:grid-cols-3">
        {t.why.items.map((item, i) => (
          <li class="rounded-2xl border border-line bg-surface p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-brand-soft text-sm font-bold text-brand">{pad(i + 1)}</span>
            <h3 class="mt-5 text-lg font-semibold">{item.title}</h3>
            <p class="mt-2 leading-relaxed text-mute">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- How it works -->
  <section id="how" class="scroll-mt-20">
    <div class={`${container} py-20`}>
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t.how.title}</h2>
      <ol class="mt-12 grid gap-8 md:grid-cols-3">
        {t.how.steps.map((step, i) => (
          <li class="relative border-l-2 border-brand/40 pl-6">
            <span class="text-sm font-bold text-brand">{pad(i + 1)}</span>
            <h3 class="mt-2 text-lg font-semibold">{step.title}</h3>
            <p class="mt-2 leading-relaxed text-mute">{step.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Topics -->
  <section id="topics" class="scroll-mt-20 border-t border-line">
    <div class={`${container} py-20`}>
      <h2 class="text-3xl font-extrabold tracking-tight sm:text-4xl">{t.topics.title}</h2>
      <p class="mt-4 max-w-2xl text-lg text-mute">{t.topics.lead}</p>
      <ul class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {topics.map((topic) => (
          <li>
            <a href={`/${lang}/${topic.data.key}/`}
              class="group flex h-full flex-col rounded-2xl border border-line bg-surface p-6 transition motion-safe:hover:-translate-y-0.5 hover:border-brand hover:shadow-lg">
              <span class="text-sm font-bold text-brand">{pad(topic.data.order)}</span>
              <h3 class="mt-3 text-xl font-semibold tracking-tight">{topic.data.title}</h3>
              <p class="mt-2 flex-1 leading-relaxed text-mute">{topic.data.summary}</p>
              <p class="mt-5 flex items-center justify-between text-sm">
                <span class="text-mute">{topic.data.cards.length} {t.topics.cards}</span>
                <span class="font-semibold text-brand transition group-hover:translate-x-0.5">{t.topics.open} →</span>
              </p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>
